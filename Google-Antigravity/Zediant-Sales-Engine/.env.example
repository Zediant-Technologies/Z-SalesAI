# Apollo.io API Key
APOLLO_API_KEY=

# Zoho CRM Credentials
# Create app at: https://api-console.zoho.com/ (Server-based Applications)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:8080/callback
ZOHO_API_DOMAIN=https://www.zohoapis.com
# Tokens generated using: zoho-mcp-auth
ZOHO_ACCESS_TOKEN=
ZOHO_REFRESH_TOKEN=

# Saleshandy API
# Generate at: Saleshandy -> Settings -> Integrations / API
SALESHANDY_API_KEY=
SALESHANDY_API_BASE_URL=https://open-api.saleshandy.com/v1
